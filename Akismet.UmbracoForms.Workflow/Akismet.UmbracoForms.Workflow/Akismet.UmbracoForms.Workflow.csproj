<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <PackageId>Akismet.UmbracoForms.Workflow</PackageId>
    <RootNamespace>Akismet.Umbraco.Forms.Workflows</RootNamespace>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <Authors>Adam Humpherys</Authors>
    <Description>Akismet spam-check workflow for Umbraco Forms (Umbraco 13)</Description>
    <Copyright>(c) $([System.DateTime]::UtcNow.ToString(`yyyy`)) Adam Humpherys</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/ahwm/Akismet.Umbraco</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ahwm/Akismet.Umbraco</RepositoryUrl>
    <PackageReleaseNotes>Updated to target Umbraco Forms for Umbraco 13; now uses async APIs. Please report issues at https://github.com/ahwm/Akismet.Umbraco/issues</PackageReleaseNotes>
    <PackageTags>umbraco umbraco-forms akismet spam antispam workflow umbraco-marketplace</PackageTags>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <Version>1.0.0-beta1</Version>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Umbraco.Forms.Core" Version="[13.0.0,13.99999.0)" />
    <PackageReference Include="Akismet.Umbraco" Version="5.0.0-beta2" />
    <PackageReference Include="AkismetApi.Net" Version="3.0.0.1" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <PropertyGroup>
    <AllowedOutputExtensionsInPackageBuildOutputFolder>
      $(AllowedOutputExtensionsInPackageBuildOutputFolder);.pdb
    </AllowedOutputExtensionsInPackageBuildOutputFolder>
  </PropertyGroup>
</Project>
